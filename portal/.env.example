# ─── Omni Loop Portal configuration ─────────────────────────────────────────
# Copy to .env.local and fill in. Everything works out of the box for local
# development: billing falls back to mock mode and the database is created
# automatically under ./data/.

# Public base URL of this portal (used in OAuth verification URIs and emails)
PORTAL_BASE_URL=http://localhost:4280

# Secret used to sign browser session cookies (any long random string)
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# ─── OpenRouter (upstream model provider) ────────────────────────────────────
# The portal proxies all inference through OpenRouter using this master key.
# Charge this key with credit at https://openrouter.ai/credits
OPENROUTER_API_KEY=

# ─── Tool Gateway upstream keys ──────────────────────────────────────────────
# Each service lights up for entitled plans only when its house key is set;
# leave empty to run a models-only portal. The Clioloop agent routes its
# web/image/TTS/browser tools through {PORTAL_BASE_URL}/api/gateway/{vendor}.
FIRECRAWL_API_KEY=       # web search & extract  (https://firecrawl.dev)
VIDU_API_KEY=            # video generation      (https://platform.vidu.com)
OPENAI_API_KEY=          # text-to-speech        (https://platform.openai.com)
BROWSER_USE_API_KEY=     # cloud browser         (https://browser-use.com)
# Optional self-hosted upstream overrides:
# FIRECRAWL_UPSTREAM_URL=  VIDU_UPSTREAM_URL=  OPENAI_AUDIO_UPSTREAM_URL=  BROWSER_USE_UPSTREAM_URL=
# Optional Vidu metering override, in usage micros per generated second:
# VIDU_GATEWAY_RATE_540P_MICROS_PER_SECOND=42000
# VIDU_GATEWAY_RATE_720P_MICROS_PER_SECOND=66000
# VIDU_GATEWAY_RATE_1080P_MICROS_PER_SECOND=78000

# ─── Stripe billing ──────────────────────────────────────────────────────────
# Leave empty for local development: the portal runs in MOCK billing mode and
# plan changes apply instantly without payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs created in the Stripe dashboard (EUR / month)
STRIPE_PRICE_PRO=        # €20/mo
STRIPE_PRICE_MAX=        # €100/mo
STRIPE_PRICE_MAX20X=     # €250/mo

# ─── Storage ─────────────────────────────────────────────────────────────────
# Directory for the SQLite database (defaults to ./data next to the app)
PORTAL_DATA_DIR=
