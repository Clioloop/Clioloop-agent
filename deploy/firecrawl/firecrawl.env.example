# Example /opt/firecrawl/.env for the self-hosted Firecrawl stack.
# Used by docker compose for ${...} interpolation in the upstream compose.
# Copy to /opt/firecrawl/.env and adjust. Keep secrets out of git.

# Publish the api on localhost only (compose maps "${PORT}:${INTERNAL_PORT}").
# Never expose publicly — Firecrawl auth is disabled below.
PORT=127.0.0.1:3002
INTERNAL_PORT=3002

# Auth is the portal's job — the tool gateway is the only client.
USE_DB_AUTHENTICATION=false

# Private SearXNG (see docker-compose.override.local.yml) for /v2/search.
SEARXNG_ENDPOINT=http://searxng:8080
SEARXNG_ENGINES=google,duckduckgo,bing,brave
SEARXNG_CATEGORIES=general

# Concurrency — tuned for an 8 vCPU / 16 GB box co-located with the portal.
# Watch `free -h` / `docker stats` before raising further.
NUM_WORKERS_PER_QUEUE=8
MAX_CONCURRENT_JOBS=6
