  },
  "homepage": "https://github.com/Clioloop/Clioloop-agent#readme",
  "dependencies": {
    "@assistant-ui/store": "0.2.13",
    "@assistant-ui/tap": "0.5.14",
    "@streamdown/math": "^1.0.2",
    "agent-browser": "^0.26.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "esbuild": "0.28.1",
    "tar": "7.5.22",
    "shell-quote": "1.10.0",
    "concurrently": "10.0.5",
    "vitest": "4.1.10",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@assistant-ui/store": "0.2.13",
    "@assistant-ui/tap": "0.5.14"
